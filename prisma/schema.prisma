// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── ENUMS ─────────────────────────

enum VehicleType {
  CAR
  VAN
  SUV
  MOTORCYCLE
  THREE_WHEELER
  BUS
  LORRY
  TRACTOR
  HEAVY_DUTY
  PICKUP
  OTHER
}

enum Condition {
  BRAND_NEW
  USED
  RECONDITIONED
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
  CNG
  OTHER
}

enum Transmission {
  MANUAL
  AUTOMATIC
  TIPTRONIC
  CVT
}

enum ListingStatus {
  DRAFT       // seller draft or admin-disabled listing
  PENDING     // waiting for admin approval
  ACTIVE      // live on the site
  SOLD        // seller marked it sold
  EXPIRED     // passed expiresAt
  REJECTED    // admin rejected it
}

enum UserRole {
  USER
  ADMIN
}

// ─────────────────── BETTER AUTH MODELS ───────────────────
// Better Auth requires these four. Names and fields must match
// what the library expects, or auth silently fails.

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // our own extra fields
  phone         String?
  phoneVerified Boolean   @default(false)
  phoneOtp      String?
  phoneOtpExpiresAt DateTime?
  role          UserRole  @default(USER)
  isBanned      Boolean   @default(false)

  sessions      Session[]
  accounts      Account[]
  listings      Listing[]
  favorites     Favorite[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?     // hashed — only for email/password accounts
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// ──────────────────── DOMAIN MODELS ────────────────────

model Brand {
  id     String      @id @default(cuid())
  name   String      @unique        // "Toyota"
  slug   String      @unique        // "toyota"
  logo   String?
  type   VehicleType @default(CAR)

  models   Model[]
  listings Listing[]

  @@map("brands")
}

model Model {
  id      String @id @default(cuid())
  name    String            // "Aqua"
  slug    String
  brandId String

  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  listings Listing[]

  @@unique([brandId, slug])   // "corolla" can exist under Toyota AND under another brand
  @@map("models")
}

model District {
  id   String @id @default(cuid())
  name String @unique        // "Colombo"
  slug String @unique

  listings Listing[]

  @@map("districts")
}

model Listing {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  description String @db.Text

  // classification
  vehicleType VehicleType
  condition   Condition
  brandId     String
  modelId     String?
  trim        String?          // "G Grade", "Sport"

  // specs
  year          Int
  mileage       Int?           // km; null for brand new
  fuelType      FuelType
  transmission  Transmission
  engineCc      Int?
  exteriorColor String?

  // commercial
  price      Int              // whole rupees
  negotiable Boolean @default(true)

  // location + contact
  districtId  String
  city        String
  contactName String
  contactPhone String

  // lifecycle
  status     ListingStatus @default(PENDING)
  moderationNote String?
  isFeatured Boolean       @default(false)
  viewCount  Int           @default(0)
  publishedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  userId String

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand     Brand          @relation(fields: [brandId], references: [id])
  model     Model?         @relation(fields: [modelId], references: [id])
  district  District       @relation(fields: [districtId], references: [id])
  images    ListingImage[]
  favorites Favorite[]

  // indexes — these make filtering fast
  @@index([status, publishedAt])
  @@index([vehicleType, status])
  @@index([brandId, modelId])
  @@index([districtId])
  @@index([price])
  @@index([userId])
  @@map("listings")
}

model ListingImage {
  id        String @id @default(cuid())
  url       String
  key       String            // UploadThing file key — needed to DELETE the file
  order     Int    @default(0)
  listingId String

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_images")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])   // a user can't save the same ad twice
  @@map("favorites")
}