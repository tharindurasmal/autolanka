generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── ENUMS ─────────────────────────

enum VehicleType {
  CAR
  VAN
  SUV
  MOTORCYCLE
  THREE_WHEELER
  BUS
  LORRY
  TRACTOR
  HEAVY_DUTY
  PICKUP
  OTHER
}

enum Condition {
  BRAND_NEW
  USED
  RECONDITIONED
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
  CNG
  OTHER
}

enum Transmission {
  MANUAL
  AUTOMATIC
  TIPTRONIC
  CVT
}

enum ListingStatus {
  DRAFT        // seller draft or admin-disabled listing
  PENDING      // waiting for admin approval
  ACTIVE       // live on the site
  SOLD         // seller marked it sold
  EXPIRED      // passed expiresAt
  REJECTED     // admin rejected it
}

enum UserRole {
  USER
  ADMIN
}

// ─────────────────── BETTER AUTH MODELS ───────────────────

model User {
  id                String    @id
  name              String
  email             String    @unique
  emailVerified     Boolean   @default(false)
  image             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  phone             String?
  phoneVerified     Boolean   @default(false)
  phoneOtp          String?
  phoneOtpExpiresAt DateTime?
  role              UserRole  @default(USER)
  isBanned          Boolean   @default(false)

  sessions          Session[]
  accounts          Account[]
  listings          Listing[]
  favorites         Favorite[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String   @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// ──────────────────── DOMAIN MODELS ────────────────────

model Brand {
  id      String      @id @default(cuid())
  name    String                                // e.g., "Toyota"
  slug    String                                // e.g., "toyota"
  logo    String?
  type    VehicleType @default(CAR)

  models   Model[]
  listings Listing[]

  // Composite unique constraints to allow separate records per vehicle type (e.g., Toyota-Car vs Toyota-Pickup)
  @@unique([name, type])
  @@unique([slug, type])
  @@map("brands")
}

model Model {
  id      String      @id @default(cuid())
  name    String                                // e.g., "Hilux" or "Aqua"
  slug    String
  brandId String
  type    VehicleType @default(CAR)

  brand    Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  listings Listing[]

  // Ensures models are unique per brand and vehicle type combination
  @@unique([brandId, slug, type])
  @@index([brandId, type])
  @@map("models")
}

model District {
  id      String @id @default(cuid())
  name    String @unique
  slug    String @unique

  cities    City[]
  listings  Listing[]

  @@map("districts")
}

model City {
  id         String   @id @default(cuid())
  name       String
  slug       String
  districtId String

  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  listings   Listing[]

  @@unique([districtId, slug])
  @@index([districtId])
  @@map("cities")
}

model Listing {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  description String @db.Text

  vehicleType VehicleType
  condition   Condition
  brandId     String
  modelId     String?
  trim        String?

  year        Int
  mileage     Int?
  fuelType    FuelType
  transmission Transmission
  engineCc    Int?
  exteriorColor String?

  price       Int
  negotiable  Boolean @default(true)

  districtId  String
  cityId      String?
  contactName String
  contactPhone String

  status         ListingStatus @default(PENDING)
  moderationNote String?
  isFeatured     Boolean       @default(false)
  viewCount      Int           @default(0)
  publishedAt    DateTime?
  expiresAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  userId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand    Brand    @relation(fields: [brandId], references: [id])
  model    Model?   @relation(fields: [modelId], references: [id])
  district District @relation(fields: [districtId], references: [id])
  city     City?    @relation(fields: [cityId], references: [id])
  images   ListingImage[]
  favorites Favorite[]

  @@index([status, publishedAt])
  @@index([vehicleType, status])
  @@index([brandId, modelId])
  @@index([districtId])
  @@index([cityId])
  @@index([price])
  @@index([userId])
  @@map("listings")
}

model ListingImage {
  id        String @id @default(cuid())
  url       String
  key       String
  order     Int    @default(0)
  listingId String

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_images")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@map("favorites")
}